# ── הגנה על ספריית הגופנים ──────────────────────────────────────────────────
# נדרש לפי תנאי הרישיון של אות.חיים: "בתנאי ששרת האינטרנט אליו מועלים קובצי
# הגופן מאובטח כדי למנוע גישה בלתי מורשית להורדת הגופן", וכן "אין להפיץ את
# הגופנים לצדדים שלישיים".
#
# מה זה עושה:
#   1. מבטל דפדוף בספרייה, כדי שלא תהיה רשימת גופנים פתוחה להורדה.
#   2. חוסם hotlinking: בקשה לקובץ גופן שמגיעה עם Referer של אתר זר נדחית.
#
# מה זה לא עושה (מגבלה מובנית של הטכנולוגיה):
#   אי אפשר למנוע לגמרי הורדה של web font, כי הדפדפן של המבקר חייב להוריד את
#   הקובץ כדי להציג אותו. זו ההגנה הסבירה והמקובלת, לא חסימה מוחלטת.
#
# ⚠️ חשוב: בקשה בלי Referer כלל (Referer ריק) חייבת לעבור. דפדפנים והגדרות
# פרטיות רבים מסירים את הכותרת הזו, וחסימה שלה הייתה שוברת את האתר לגולשים
# אמיתיים. נחסמות רק בקשות שנושאות Referer של דומיין זר.
#
# ⚠️⚠️ רשימת הדומיינים המותרים מופיעה בשורת ה-RewriteCond למטה. אם האתר עובר
# לדומיין חדש שאינו ברשימה, כל הגופנים ייחסמו והטיפוגרפיה תישבר.
# מותר כרגע: unichord.co.il, unichord.co.il, unichord.com (וכל תת דומיין שלהם).
# עודכן 28.7.2026 לקראת המעבר ל-unichord.co.il.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # תנאי 1: Referer ריק או חסר -> לא נחסם (ממשיכים רק אם הוא לא ריק)
    RewriteCond %{HTTP_REFERER} !^$
    # תנאי 2: Referer של אחד מהדומיינים שלנו -> לא נחסם
    RewriteCond %{HTTP_REFERER} !^https?://([^/]+\.)?(achordim|unichord)\.(com|co\.il)(:[0-9]+)?(/|$) [NC]
    # מה שנשאר: Referer זר -> חסימה
    RewriteRule \.(woff2?|ttf|otf|eot)$ - [F,L]
</IfModule>

# ── END הגנה על ספריית הגופנים ──────────────────────────────────────────────
